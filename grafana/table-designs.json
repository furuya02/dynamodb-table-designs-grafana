{
  "uid": "table-designs",
  "title": "Four table designs (Ductus)",
  "description": "Four common DynamoDB table designs, read through Ductus without changing the tables",
  "tags": [
    "dynamodb-table-designs-grafana",
    "dynamodb"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "refresh": "",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "(1) Date-split partition key: power",
      "description": "pk = meter-01#2026-11-16 (JST date), ts = epoch seconds",
      "type": "timeseries",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "tsapi"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "tsapi"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "url": "query",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": [
              {
                "key": "dataset",
                "value": "power"
              },
              {
                "key": "key",
                "value": "meter-01,meter-02"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              },
              {
                "key": "interval",
                "value": "${__interval_ms}"
              },
              {
                "key": "agg",
                "value": "avg"
              },
              {
                "key": "fields",
                "value": "watt"
              }
            ]
          },
          "root_selector": "rows",
          "columns": [
            {
              "selector": "time",
              "text": "time",
              "type": "timestamp_epoch"
            },
            {
              "selector": "key",
              "text": "key",
              "type": "string"
            },
            {
              "selector": "watt",
              "text": "watt",
              "type": "number"
            }
          ],
          "filters": [],
          "format": "timeseries"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "displayName": "${__field.labels.key}",
          "custom": {
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
